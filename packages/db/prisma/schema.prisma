generator client {
  provider = "prisma-client-js"
  // binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Enums
// ============================================

enum Tier {
  FREE
  PRO
  TEAM
}

enum MockServerStatus {
  BUILDING
  RUNNING
  STOPPED
  FAILED
  REMOVED
}

enum SpecFormat {
  YAML
  JSON
}

// ============================================
// Models
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  
  emailVerified Boolean   @default(false)
  image         String?
  
  githubId  String?  @unique
  avatarUrl String?
  tier      Tier     @default(FREE)

  // Lemon Squeezy billing
  lemonSqueezyCustomerId     String?
  lemonSqueezySubscriptionId String?
  subscriptionStatus         String?   // active | cancelled | expired | past_due
  subscriptionRenewsAt       DateTime?
  subscriptionEndsAt         DateTime?

  specs       Spec[]
  mockServers MockServer[]
  specDrafts  SpecDraft[]
  sessions    Session[]
  accounts    Account[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Spec {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String

  versions    SpecVersion[]
  mockServers MockServer[]
  drafts      SpecDraft[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@map("specs")
}

model SpecVersion {
  id      String     @id @default(cuid())
  specId  String
  spec    Spec       @relation(fields: [specId], references: [id], onDelete: Cascade)
  version Int
  content String     // Raw YAML/JSON text
  format  SpecFormat
  hash    String     // SHA256 of content for dedup

  mockServers MockServer[]

  createdAt DateTime @default(now())

  @@unique([specId, version])
  @@index([specId])
  @@map("spec_versions")
}

model MockServer {
  id                String           @id @default(cuid())
  specId            String
  spec              Spec             @relation(fields: [specId], references: [id], onDelete: Cascade)
  specVersionId     String
  specVersion       SpecVersion      @relation(fields: [specVersionId], references: [id])
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  dockerImageId     String?
  dockerContainerId String?
  status            MockServerStatus @default(BUILDING)
  publicUrl         String?
  port              Int?
  tier              Tier

  // Contour CLI options
  isStateful      Boolean @default(false)
  isDeterministic Boolean @default(false)
  delay           String?
  errorRate       Int     @default(0)
  requireAuth     Boolean @default(false)
  strictValidation Boolean @default(false)
  strictLevel      String?

  // Partner sandbox fields
  expiresAt        DateTime?        // deliberate expiry — distinct from idle auto-stop
  label            String?          // human-friendly sandbox name, e.g. "Acme Corp"
  sharePageEnabled Boolean @default(false)
  description      String?          // shown on sandbox share page

  requestLogs SandboxRequestLog[]

  lastAccessedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  @@index([userId])
  @@index([specId])
  @@index([status])
  @@index([expiresAt])
  @@map("mock_servers")
}

model SandboxRequestLog {
  id             String     @id @default(cuid())
  mockServerId   String
  mockServer     MockServer @relation(fields: [mockServerId], references: [id], onDelete: Cascade)

  method         String     // GET, POST, PUT, DELETE, etc.
  path           String     // /users, /transactions/{id}, etc.
  statusCode     Int        // 200, 404, 400, etc.
  responseTimeMs Int?       // optional latency tracking
  userAgent      String?    // caller's user-agent header
  ipAddress      String?    // caller's IP

  createdAt      DateTime   @default(now())

  @@index([mockServerId])
  @@index([mockServerId, createdAt])
  @@index([createdAt])
  @@map("sandbox_request_logs")
}

model ContractTestRun {
  id        String @id @default(cuid())
  specId    String
  userId    String
  baseUrl   String
  results   Json   // Array of endpoint pass/fail results
  summary   Json   // { total, passed, failed }
  status    String @default("running") // running | completed | failed

  createdAt DateTime @default(now())

  @@index([specId])
  @@index([userId])
  @@map("contract_test_runs")
}

model SpecDraft {
  id        String   @id @default(cuid())
  userId    String
  specId    String?  // null = new unsaved draft; set once linked to a Spec
  title     String?
  content   String   // JSON.stringify'd OpenAPI spec object
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  spec Spec? @relation(fields: [specId], references: [id], onDelete: SetNull)

  @@unique([userId, specId])
  @@index([userId])
  @@map("spec_drafts")
}

// ============================================
// Resend Models
// ============================================

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  source    String?  // e.g. "landing-page", "waitlist-page"
  notified  Boolean  @default(false) // flip to true when launch email sent

  @@map("waitlist_entries")
}

// ============================================
// BetterAuth Models
// ============================================

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  providerId        String
  accessToken       String?
  refreshToken      String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope             String?
  idToken           String?
  password          String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}
